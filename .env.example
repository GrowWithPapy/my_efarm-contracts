# Copy to contracts/.env and fill in. .env is gitignored; never commit a key.
#
# Distribute.s.sol reads every one of these. There are no defaults on purpose: a launch
# script that silently falls back to the deployer address would put 15 % of the supply
# somewhere nobody chose.

# --- where the slices go (ECONOMY.md §11.7) ---
# The LP slice. Goes to whoever will create the Uniswap V4 pool; the script does not pair
# liquidity itself (see the note at the top of Distribute.s.sol).
LIQUIDITY_ADDRESS=0x0000000000000000000000000000000000000000
# Beneficiaries of the two vesting contracts. These addresses cannot be changed afterwards.
COMMUNITY_BENEFICIARY=0x0000000000000000000000000000000000000000
TEAM_BENEFICIARY=0x0000000000000000000000000000000000000000
# Exchange-listing float, held rather than provided as liquidity.
LISTINGS_MULTISIG=0x0000000000000000000000000000000000000000

# --- the vault's two keys ---
# Signs withdrawal vouchers. This is the backend's hot key: it authorises exits, so it is
# the one key worth rotating on a schedule (the guardian can, without redeploying).
VAULT_OPERATOR=0x0000000000000000000000000000000000000000
# The 2-of-3 Safe that may pause withdrawals and rotate the operator. The threshold lives
# in the Safe, not in the contract.
VAULT_GUARDIAN=0x0000000000000000000000000000000000000000

# --- deployment ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=
# Prefer --ledger or --account (an encrypted keystore) over a raw key in this file.
# PRIVATE_KEY=
